generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  USER
  ADMIN
}

enum AssetType {
  STOCK
  CRYPTO
}

enum NotificationType {
  SYSTEM
  MARKET
  PORTFOLIO
  NEWS
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ResearchReportType {
  MARKET_COVERAGE
  ANALYSIS
  ECONOMY
  STRATEGY
}

enum ResearchReportStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum NewsletterStatus {
  DRAFT
  SCHEDULED
  SENT
  ARCHIVED
}

enum FetchStrategy {
  SCRAPE
  RSS
  API
  MANUAL
}

enum ProviderHealthStatus {
  HEALTHY
  DEGRADED
  FAILED
}

model User {
  id                  String               @id @default(uuid())
  email               String               @unique
  passwordHash        String
  role                Role                 @default(USER)
  isEmailVerified     Boolean              @default(false)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  profile             Profile?
  refreshTokens       RefreshToken[]
  portfolioAssets     PortfolioAsset[]
  watchlists          Watchlist[]
  comments            Comment[]
  replies             Reply[]
  notifications       Notification[]
  passwordResetTokens PasswordResetToken[]
  articleBookmarks    ArticleBookmark[]

  @@index([email])
}

model Profile {
  id          String   @id @default(uuid())
  userId      String   @unique
  displayName String
  username    String   @unique
  avatarUrl   String?
  bio         String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Stock {
  id              String          @id @default(uuid())
  ticker          String          @unique
  companyName     String
  sector          String
  description     String?
  currentPrice    Float           @default(0)
  dailyChange     Float           @default(0)
  percentChange   Float           @default(0)
  marketCap       Float?
  eps             Float?
  peRatio         Float?
  dividendYield   Float?
  volume          Float?
  week52High      Float?
  week52Low       Float?
  trendScore      Float           @default(0)
  lastUpdatedAt   DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  prices          StockPrice[]
  assetCategories AssetCategory[]

  @@index([ticker])
  @@index([sector])
  @@index([trendScore])
}

model StockPrice {
  id         String             @id @default(uuid())
  stockId     String
  providerId String?
  date       DateTime
  open       Float
  high       Float
  low        Float
  close      Float
  volume     Float?
  createdAt  DateTime           @default(now())
  stock      Stock              @relation(fields: [stockId], references: [id], onDelete: Cascade)
  provider   StockDataProvider? @relation(fields: [providerId], references: [id], onDelete: SetNull)

  @@unique([stockId, date])
  @@index([date])
  @@index([providerId])
}

model CryptoAsset {
  id                String          @id @default(uuid())
  symbol            String          @unique
  name              String
  coingeckoId       String          @unique
  description       String?
  imageUrl          String?
  currentPrice      Float           @default(0)
  marketCap         Float?
  change24h         Float           @default(0)
  volume24h         Float?
  circulatingSupply Float?
  trendScore        Float           @default(0)
  lastUpdatedAt     DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  prices            CryptoPrice[]
  assetCategories   AssetCategory[]

  @@index([symbol])
  @@index([trendScore])
}

model CryptoPrice {
  id            String      @id @default(uuid())
  cryptoAssetId String
  date          DateTime
  open          Float
  high          Float
  low           Float
  close         Float
  volume        Float?
  createdAt     DateTime    @default(now())
  cryptoAsset   CryptoAsset @relation(fields: [cryptoAssetId], references: [id], onDelete: Cascade)

  @@unique([cryptoAssetId, date])
  @@index([date])
}

model SectorCategory {
  id            String          @id @default(uuid())
  name          String          @unique
  slug          String          @unique
  description   String?
  icon          String?
  color         String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  assetMappings AssetCategory[]

  @@index([slug])
}

model AssetCategory {
  id            String         @id @default(uuid())
  stockId       String?
  cryptoAssetId String?
  categoryId    String
  createdAt     DateTime       @default(now())
  stock         Stock?         @relation(fields: [stockId], references: [id], onDelete: Cascade)
  cryptoAsset   CryptoAsset?   @relation(fields: [cryptoAssetId], references: [id], onDelete: Cascade)
  category      SectorCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId])
  @@index([stockId, categoryId])
  @@index([cryptoAssetId, categoryId])
}

model Watchlist {
  id        String          @id @default(uuid())
  userId    String
  name      String          @default("My Watchlist")
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     WatchlistItem[]

  @@index([userId])
}

model WatchlistItem {
  id          String    @id @default(uuid())
  watchlistId String
  assetType   AssetType
  assetSymbol String
  position    Int       @default(0)
  createdAt   DateTime  @default(now())
  watchlist   Watchlist @relation(fields: [watchlistId], references: [id], onDelete: Cascade)

  @@unique([watchlistId, assetType, assetSymbol])
  @@index([watchlistId, position])
}

model PortfolioAsset {
  id          String    @id @default(uuid())
  userId      String
  assetType   AssetType
  assetSymbol String
  quantity    Float
  buyPrice    Float
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, assetType])
  @@index([assetSymbol])
}

model Comment {
  id          String    @id @default(uuid())
  userId      String
  assetType   AssetType
  assetSymbol String
  content     String
  upvotes     Int       @default(0)
  isModerated Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  replies     Reply[]

  @@index([assetType, assetSymbol])
  @@index([userId])
}

model Reply {
  id          String   @id @default(uuid())
  userId      String
  commentId   String
  content     String
  upvotes     Int      @default(0)
  isModerated Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  comment     Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@index([commentId])
  @@index([userId])
}

model Category {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  newsItems   News[]

  @@index([slug])
}

model NewsSource {
  id            String        @id @default(uuid())
  name          String
  slug          String        @unique
  baseUrl       String
  logoUrl       String?
  isActive      Boolean       @default(true)
  fetchStrategy FetchStrategy
  config        Json          @default("{}")
  lastFetchedAt DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  newsItems     News[]

  @@index([slug, isActive])
}

model News {
  id            String      @id @default(uuid())
  categoryId    String?
  sourceId      String?
  slug          String      @unique
  title         String
  excerpt       String
  content       String
  source        String
  sourceUrl     String      @unique
  externalUrl   String?
  author        String?
  imageUrl      String?
  categoryLabel String?
  publishedAt   DateTime
  assetType     AssetType?
  assetSymbol   String?
  isInsight     Boolean     @default(false)
  trendingScore Float       @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  category      Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  sourceRef     NewsSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  @@index([publishedAt])
  @@index([assetType, assetSymbol])
  @@index([isInsight])
  @@index([sourceId])
}

model ArticleCategory {
  id          String    @id @default(uuid())
  name        String    @unique
  slug        String    @unique
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  articles    Article[]

  @@index([slug])
}

model Article {
  id           String           @id @default(uuid())
  title        String
  slug         String           @unique
  excerpt      String
  content      String
  coverImage   String?
  author       String
  authorAvatar String?
  categoryId   String?
  tags         String[]
  isFeatured   Boolean          @default(false)
  readTime     Int
  viewCount    Int              @default(0)
  publishedAt  DateTime
  status       ArticleStatus    @default(DRAFT)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  category     ArticleCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  bookmarks    ArticleBookmark[]

  @@index([slug])
  @@index([isFeatured, publishedAt])
  @@index([status])
}

model ArticleBookmark {
  id        String   @id @default(uuid())
  userId    String
  articleId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([userId, articleId])
  @@index([articleId])
}

model ResearchReport {
  id            String               @id @default(uuid())
  title         String
  slug          String               @unique
  type          ResearchReportType
  summary       String
  content       String
  coverPage     String?
  pdfUrl        String?
  reportYear    Int
  reportDate    DateTime
  author        String
  tags          String[]
  downloadCount Int                  @default(0)
  isPremium     Boolean              @default(false)
  status        ResearchReportStatus @default(DRAFT)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([type, reportYear])
  @@index([status, reportDate])
}

model PodcastEpisode {
  id            String   @id @default(uuid())
  title         String
  slug          String   @unique
  description   String
  audioUrl      String
  duration      Int
  coverImage    String?
  episodeNumber Int
  seasonNumber  Int
  tags          String[]
  publishedAt   DateTime
  playCount     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([publishedAt])
}

model TreasuryBill {
  id        String   @id @default(uuid())
  tenor     String
  rate      Decimal  @db.Decimal(10, 4)
  date      DateTime
  source    String
  createdAt DateTime @default(now())

  @@index([date, tenor])
}

model NewsletterSubscriber {
  id             String   @id @default(uuid())
  email          String   @unique
  isActive       Boolean  @default(true)
  preferences    Json     @default("{}")
  subscribedAt   DateTime @default(now())
  unsubscribedAt DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([email, isActive])
}

model Newsletter {
  id             String           @id @default(uuid())
  subject        String
  content        String
  status         NewsletterStatus @default(DRAFT)
  sentAt         DateTime?
  scheduledFor   DateTime?
  recipientCount Int              @default(0)
  openCount      Int              @default(0)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([status, scheduledFor])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  title     String
  message   String
  type      NotificationType @default(SYSTEM)
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}

model MarketIndex {
  id               String   @id @default(uuid())
  name             String
  symbol           String   @unique
  value            Float
  change           Float
  percentChange    Float
  marketCap        Float?
  breadthAdvancers Int      @default(0)
  breadthDecliners Int      @default(0)
  fearGreed        Int      @default(50)
  tradeDate        DateTime
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([tradeDate])
}

model StockDataProvider {
  id              String               @id @default(uuid())
  name            String
  slug            String               @unique
  baseUrl         String
  apiKey          String?
  isActive        Boolean              @default(true)
  priority        Int                  @default(0)
  rateLimitPerMin Int
  config          Json                 @default("{}")
  lastFetchedAt   DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  priceEntries    StockPrice[]
  statusLogs      ProviderStatusLog[]

  @@index([slug, isActive])
}

model ProviderStatusLog {
  id             String               @id @default(uuid())
  providerId     String
  status         ProviderHealthStatus
  responseTimeMs Int
  errorMessage   String?
  createdAt      DateTime             @default(now())
  provider       StockDataProvider    @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId, createdAt])
}

model JobRun {
  id           String   @id @default(uuid())
  jobName      String
  status       String
  startedAt    DateTime @default(now())
  completedAt  DateTime?
  message      String?
  metadataJson Json?

  @@index([jobName, startedAt])
}
